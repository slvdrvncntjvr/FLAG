{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:worker:dev": "opennextjs-cloudflare build --env dev",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && npm run deploy:worker",
    "deploy:dev": "npm run build:worker:dev && npm run deploy:worker:dev",
    "deploy:worker": "node scripts/check-deploy.mjs && opennextjs-cloudflare deploy",
    "deploy:worker:dev": "node scripts/check-deploy.mjs dev && opennextjs-cloudflare deploy --env dev",
    "verify:dev": "node scripts/verify-dev-release.mjs",
    "test": "vitest run",
    "test:deploy": "node --test scripts/check-ci-target.test.mjs scripts/r2-audit.test.mjs scripts/release-identity.test.mjs",
    "test:worker:smoke": "node scripts/smoke-built-worker.mjs",
    "audit:r2": "node scripts/audit-r2.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flag-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flag-db --remote",
    "db:migrate:dev": "wrangler d1 migrations apply flag-db-dev --remote --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@opennextjs/cloudflare": "1.20.12",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici@6": "6.29.1",
    "undici@7": "7.30.1",
    "express": {
      "body-parser": "2.4.0"
    },
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.6"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "workerd@1.20261001.1": true,
    "workerd@1.20261012.1": true
  }
}
